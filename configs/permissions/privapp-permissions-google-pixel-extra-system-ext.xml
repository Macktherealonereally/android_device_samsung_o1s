<!--
     SPDX-FileCopyrightText: 2026 Macktherealonereally
     SPDX-License-Identifier: Apache-2.0

     Privileged permissions that Pixel's own allowlist grants to these Google
     apps but MindTheGapps' (older) allowlist does not. Installed to
     /system_ext/etc/permissions only when GApps are built (MTG, AMTG).
     SystemConfig merges every <privapp-permissions> block of a package within a
     partition, so this only adds grants.

     Why: a Play-updated priv-app gets a newly requested privileged permission
     only if the factory partition's allowlist names it (frameworks/base
     "updated system app" grant). Without it the permission is silently not
     granted and the app can crash, as Play services did with GET_ROLE_HOLDERS
     (privapp-permissions-gms-extra.xml). A grant applies only if the installed,
     Google-signed APK requests the permission.

     Source: Pixel allowlists of stallion CP1A.260505.005 (Evolution-X/vendor_gms
     bka 89c3940a, privapp-permissions-google-p.xml / -se.xml), minus everything
     MindTheGapps, AMTG and gms-extra already grant or deny; only permissions that
     frameworks/base defines as signature|privileged (signatureOrSystem included).
-->
<permissions>
    <privapp-permissions package="com.google.android.setupwizard">
        <permission name="android.permission.SCHEDULE_EXACT_ALARM"/>
        <permission name="android.permission.SET_BIOMETRIC_DIALOG_ADVANCED"/>
    </privapp-permissions>
</permissions>
